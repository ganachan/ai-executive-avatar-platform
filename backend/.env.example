# Azure Speech (TTS Avatar)
# Leave AZURE_SPEECH_KEY blank to use Entra ID auth (az login / managed identity)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westus2

# Azure OpenAI / Foundry
# Leave AZURE_OPENAI_KEY blank to use Entra ID auth (az login / managed identity)
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=https://aiavatarmodelsrg.services.ai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# VASA-1 photo avatar endpoint (optional — set when Azure Custom Avatar / VASA is provisioned)
# Format: https://{region}.api.cognitive.microsoft.com/avatar/vasa/v1
AZURE_VASA_ENDPOINT=

# ── Open-source model (Fireworks MiniMax via Azure AI Foundry) ────────────────
# Default: avatar chat is routed through MiniMax (FW-MiniMax-M2.5) instead of GPT-4o
# for lower inference cost. Set CHAT_MODEL_PROVIDER=azure to use GPT-4o instead.
# Requires the FW-MiniMax-M2.5 model deployed in your AI Foundry project.
# Auth: Entra ID only (az login) — scope https://ai.azure.com/.default
CHAT_MODEL_PROVIDER=minimax
MINIMAX_ENDPOINT=https://aiavatarmodelsrg.services.ai.azure.com/openai/v1
MINIMAX_DEPLOYMENT=FW-MiniMax-M2.5
