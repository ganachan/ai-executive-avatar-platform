# Azure Speech (TTS Avatar)
# Leave AZURE_SPEECH_KEY blank to use Entra ID auth (az login / managed identity)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westus2

# Azure OpenAI / Foundry
# Leave AZURE_OPENAI_KEY blank to use Entra ID auth (az login / managed identity)
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=https://aiavatarmodelsrg.services.ai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# VASA-1 photo avatar endpoint (optional — set when Azure Custom Avatar / VASA is provisioned)
# Format: https://{region}.api.cognitive.microsoft.com/avatar/vasa/v1
AZURE_VASA_ENDPOINT=
